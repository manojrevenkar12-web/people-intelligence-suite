{
  "id": "peopleSelfService",
  "name": "People self-service",
  "nodes": [
    {
      "id": "question-in",
      "name": "Question in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "people-help",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "chatWebhookSecret",
          "name": "chat webhook secret"
        }
      }
    },
    {
      "id": "ask-the-assistant",
      "name": "Ask the assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PIS_API_URL }}/ask",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.body.user.email, question: $json.body.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "pisApiToken",
          "name": "people-intelligence API token"
        }
      }
    },
    {
      "id": "needs-a-person?",
      "name": "Needs a person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.kind }}",
              "rightValue": "handoff",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "open-people-ticket",
      "name": "Open People ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_URL }}/tickets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ queue: $json.queue, reason: $json.reason, requester: $('Question in').item.json.body.user.email, text: $('Question in').item.json.body.text }) }}",
        "options": {
          "retry": {
            "maxTries": 3
          }
        }
      }
    },
    {
      "id": "reply",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ text: $('Ask the assistant').item.json.text, citations: $('Ask the assistant').item.json.citations, kind: $('Ask the assistant').item.json.kind }) }}"
      }
    }
  ],
  "connections": {
    "Question in": {
      "main": [
        [
          {
            "node": "Ask the assistant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the assistant": {
      "main": [
        [
          {
            "node": "Needs a person?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs a person?": {
      "main": [
        [
          {
            "node": "Open People ticket",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open People ticket": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
